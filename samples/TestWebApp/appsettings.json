{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=TrustIdentity.db"
  },
  "Urls": "https://localhost:5001;http://localhost:5000",
  "JwtSettings": {
    "SigningKey": "REPLACE-THIS-WITH-SECURE-KEY-USE-USER-SECRETS-IN-PRODUCTION-MINIMUM-32-CHARACTERS",
    "Issuer": "https://localhost:5001",
    "AccessTokenLifetimeHours": 1,
    "RefreshTokenLifetimeDays": 30
  },
  "TrustIdentity": {
    "IssuerUri": "https://localhost:5001",
    "RequireHttps": true,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "security@trustidentity.local",
      "FromName": "TrustIdentity Security"
    }
  }
}