{
    "TrustIdentity": {
        "IssuerUri": "https://localhost:5001",
        "Logging": {
            "EnableSecurityLogging": true,
            "LogFraudEvents": true
        },
        "FraudDetection": {
            "EnableAiAnalysis": true,
            "Threshold": 0.8
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=TrustIdentity.db"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}