@page
@model TrustIdentity.UI.Pages.Grants.IndexModel
@{
    ViewData["Title"] = "Application Access";
}

<div class="auth-card wide">
    <div class="auth-header" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);">
        <div class="auth-logo">
            <i class="fas fa-shield-check"></i>
        </div>
        <h1>Application Access</h1>
        <p>Review and manage the third-party apps connected to your account</p>
    </div>

    <div class="auth-body">
        @if (!Model.Grants.Any())
        {
            <div class="alert alert-info border-0 shadow-sm p-4 text-center" style="display: flex; flex-direction: column; align-items: center;">
                <i class="fas fa-info-circle" style="font-size: 32px; margin-bottom: 16px;"></i>
                <h4 style="font-size: 18px; margin-bottom: 8px;">No applications have access yet</h4>
                <p style="margin: 0; opacity: 0.8;">External applications you sign into will appear here.</p>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
                @foreach (var grant in Model.Grants)
                {
                    <div class="grant-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; transition: all 0.3s ease; display: flex; flex-direction: column;">
                        <div style="padding: 24px; flex-grow: 1;">
                            <div style="display: flex; align-items: center; margin-bottom: 20px;">
                                @if (!string.IsNullOrEmpty(grant.ClientLogoUrl))
                                {
                                    <div style="width: 50px; height: 50px; border-radius: 12px; overflow: hidden; margin-right: 16px; border: 1px solid #e2e8f0; background: white;">
                                        <img src="@grant.ClientLogoUrl" alt="@grant.ClientName" style="width: 100%; height: 100%; object-fit: contain;">
                                    </div>
                                }
                                else
                                {
                                    <div style="width: 50px; height: 50px; border-radius: 12px; background: #e2e8f0; display: flex; align-items: center; justify-content: center; margin-right: 16px; color: #64748b;">
                                        <i class="fas fa-app-grid" style="font-size: 24px;"></i>
                                    </div>
                                }
                                <div>
                                    <h5 style="margin: 0; font-size: 16px; font-weight: 700; color: #0f172a;">@grant.ClientName</h5>
                                    <span style="font-size: 11px; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.05em;">Authorized</span>
                                </div>
                            </div>

                            <div style="margin-bottom: 16px;">
                                <div style="font-size: 12px; color: #64748b; font-weight: 600; margin-bottom: 4px;">Permissions Granted</div>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    @foreach (var scope in grant.Scopes)
                                    {
                                        <span style="background: white; border: 1px solid #e2e8f0; color: #334155; font-size: 11px; padding: 2px 8px; border-radius: 6px; font-weight: 500;">@scope</span>
                                    }
                                </div>
                            </div>

                            <div style="font-size: 12px; color: #64748b;">
                                <i class="far fa-calendar-alt" style="margin-right: 4px;"></i> Since @grant.Created.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <div style="padding: 16px; background: #f1f5f9; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px;">
                            <form asp-page-handler="Revoke" method="post">
                                <input type="hidden" name="clientId" value="@grant.ClientId" />
                                <button type="submit" class="btn btn-secondary" style="padding: 8px 16px; font-size: 13px; font-weight: 600; color: #ef4444; border-color: #fee2e2;">
                                    <i class="fas fa-trash-alt" style="margin-right: 8px;"></i> Revoke Access
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="auth-footer">
        <a href="/" class="link"><i class="fas fa-arrow-left"></i> Back to Home</a>
    </div>
</div>

<style>
    .grant-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
        border-color: var(--primary);
    }
</style>
