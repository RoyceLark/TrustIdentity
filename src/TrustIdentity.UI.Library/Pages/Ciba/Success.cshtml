@page
@{
    ViewData["Title"] = "Success";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo" style="background: #10b981;">
            <i class="fas fa-check"></i>
        </div>
        <h1>Request Processed</h1>
        <p>Your response has been sent to the application.</p>
    </div>
    <div class="auth-body">
        <p style="text-align: center; color: #64748b;">You can now close this window or return to your account.</p>
        <a href="/Manage/Index" class="btn btn-primary">Go to Account</a>
    </div>
</div>
