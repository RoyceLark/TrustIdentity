@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="auth-card wide">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-lock-keyhole"></i>
        </div>
        <h1>Privacy Policy</h1>
        <p>How we protect and manage your personal data</p>
    </div>

    <div class="auth-body">
        <div style="color: #334155; line-height: 1.8;">
            <h3 style="color: #0f172a; margin-bottom: 16px;">1. Data Collection</h3>
            <p style="margin-bottom: 24px;">TrustIdentity collects only the information necessary to provide authentication and authorization services. This includes your username, email, and authentication logs for security auditing.</p>

            <h3 style="color: #0f172a; margin-bottom: 16px;">2. AI Fraud Detection</h3>
            <p style="margin-bottom: 24px;">To protect your account, we analyze login patterns, including IP addresses and device information. This data is used solely for security purposes and is not shared with third parties for marketing.</p>

            <h3 style="color: #0f172a; margin-bottom: 16px;">3. Your Rights</h3>
            <p style="margin-bottom: 24px;">You have the right to access, download, and delete your data at any time via the Account Management portal.</p>
        </div>
    </div>

    <div class="auth-footer">
        <a href="/" class="link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    </div>
</div>
