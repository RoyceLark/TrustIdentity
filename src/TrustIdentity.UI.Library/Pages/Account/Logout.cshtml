@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-sign-out-alt"></i>
        </div>
        <h1>Logout</h1>
        <p>Are you sure you want to log out?</p>
    </div>

    <div class="auth-body text-center">
        <form method="post">
            <input type="hidden" name="logoutId" value="@Model.LogoutId" />
            <button type="submit" class="btn btn-primary mb-3">Yes, Log out</button>
            <a href="/" class="btn btn-secondary">No, Stay signed in</a>
        </form>
    </div>
</div>
