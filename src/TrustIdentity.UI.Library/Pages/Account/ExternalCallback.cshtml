@page
@model ExternalCallbackModel
@{
    ViewData["Title"] = "Processing Sign In";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            @if (ViewData["LogoUri"] != null)
            {
                <img src="@ViewData["LogoUri"]" alt="Logo" style="max-width: 100%; max-height: 100%; border-radius: 12px;" />
            }
            else
            {
                <i class="fas fa-shield-halved"></i>
            }
        </div>
        <h1>Processing Sign In</h1>
        <p>Please wait while we complete your authentication...</p>
    </div>

    <div class="auth-body text-center">
        <div class="loading-spinner">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        
        <div class="mt-4">
            <i class="fas fa-user-check text-success" style="font-size: 2rem;"></i>
            <p class="mt-3 text-muted">Verifying your identity with the external provider...</p>
        </div>

        <div class="security-badge mt-4">
            <i class="fas fa-shield-check"></i>
            <span>Protected by AI-powered fraud detection</span>
        </div>
    </div>
</div>

<style>
    .loading-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem 0;
    }

    .text-center {
        text-align: center;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .mt-4 {
        margin-top: 1.5rem;
    }

    .text-muted {
        color: #6c757d;
    }

    .text-success {
        color: #28a745;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .spinner-border {
        display: inline-block;
        width: 2rem;
        height: 2rem;
        vertical-align: text-bottom;
        border: 0.25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }
</style>
