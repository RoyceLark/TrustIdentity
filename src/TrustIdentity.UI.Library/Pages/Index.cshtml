@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="auth-card wide">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-rocket"></i>
        </div>
        <h1>Welcome to TrustIdentity</h1>
        <p>Your centralized identity and security dashboard</p>
    </div>

    <div class="auth-body">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
            <!-- Profile Card -->
            <div class="feature-card">
                <div class="icon-circle" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
                    <i class="fas fa-id-card"></i>
                </div>
                <h3>Your Profile</h3>
                <p>Manage your personal information, email addresses, and account details.</p>
                <a href="/Manage/Index" class="btn btn-secondary">Go to Profile</a>
            </div>

            <!-- Security Card -->
            <div class="feature-card">
                <div class="icon-circle" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <h3>Security Settings</h3>
                <p>Update your password, enable 2FA, and monitor active sessions.</p>
                <a href="/Manage/TwoFactor" class="btn btn-secondary">Security Center</a>
            </div>

            <!-- Apps Card -->
            <div class="feature-card">
                <div class="icon-circle" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="fas fa-grid-horizontal"></i>
                </div>
                <h3>Connected Apps</h3>
                <p>View and manage third-party applications that have access to your data.</p>
                <a href="/Grants/Index" class="btn btn-secondary">Manage Apps</a>
            </div>
        </div>

        <div class="security-badge" style="margin-top: 40px; display: flex; justify-content: center; width: 100%;">
            <i class="fas fa-shield-check"></i>
            <span>Your account is monitored and protected by AI-powered anomaly detection</span>
        </div>
    </div>
</div>

<style>
    .feature-card {
        padding: 30px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        background: white;
        border-color: var(--primary);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        font-size: 24px;
    }

    .feature-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
    }

    .feature-card p {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .feature-card .btn {
        width: auto;
        padding: 10px 20px;
        font-size: 14px;
    }
</style>
