@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile Settings";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-id-card-clip"></i>
        </div>
        <h1>Edit Profile</h1>
        <p>Update your public identity and contact information</p>
    </div>

    <div class="auth-body">
        <form method="post">
            <div class="form-group">
                <label class="form-label">Display Name</label>
                <div class="input-icon">
                    <i class="fas fa-user-tag"></i>
                    <input asp-for="Input.DisplayName" class="form-control" placeholder="The name others will see" />
                </div>
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <div class="input-icon">
                    <i class="fas fa-phone-office"></i>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                </div>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 32px;">
                <button type="submit" class="btn btn-primary">
                    <div class="loading"></div>
                    <span>Save Changes</span>
                </button>
                <a href="/Manage/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
