@page
@model TrustIdentity.UI.Pages.Device.IndexModel
@{
    ViewData["Title"] = "Device Verification";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-tv"></i>
        </div>
        <h1>Device Verification</h1>
        <p>Connect your smart device</p>
    </div>

    <div class="auth-body">
        <p style="color: #64748b; margin-bottom: 24px; text-align: center;">Enter the 8-character code shown on your device screen.</p>
        
        <form method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            
            <div class="form-group">
                <label class="form-label" asp-for="UserCode">Verification Code</label>
                <div class="input-icon">
                    <i class="fas fa-key"></i>
                    <input asp-for="UserCode" class="form-control text-center letter-spacing-custom" 
                           placeholder="CODE-HERE" style="font-size: 1.5rem; font-weight: 800; text-transform: uppercase;" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-4">
                <i class="fas fa-check-circle"></i> Verify Device
            </button>
        </form>
    </div>
    
    <div class="auth-footer">
        <a href="/" class="link">Cancel and return home</a>
    </div>
</div>

<style>
    .letter-spacing-custom {
        letter-spacing: 4px;
    }
</style>
