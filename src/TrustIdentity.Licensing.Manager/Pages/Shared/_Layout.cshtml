<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrustIdentity Licensing</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        :root {
            --primary: #6366f1;
            --primary-light: #818cf8;
            --dark: #0f172a;
            --dark-subtle: #1e293b;
            --glass: rgba(255, 255, 255, 0.05);
            --bg: #0f172a;
            --text: #f8fafc;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        .navbar {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-brand {
            font-weight: 700;
            color: var(--text) !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: rgba(255,255,255,0.7) !important;
            font-weight: 400;
            transition: all 0.2s;
        }

        .nav-link:hover {
            color: var(--primary-light) !important;
        }

        .card {
            background: var(--dark-subtle);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            color: var(--text);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .btn-primary {
            background: var(--primary);
            border: none;
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-primary:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .table {
            color: var(--text) !important;
        }

        .table-dark {
            --bs-table-bg: var(--dark-subtle);
        }

        footer {
            margin-top: auto;
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 20px 0;
            color: rgba(255,255,255,0.5);
        }

        .glass-panel {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            padding: 30px;
        }
        
        pre, code {
            background: #000;
            color: #10b981;
            border-radius: 8px;
            padding: 4px 8px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <i class="fas fa-shield-halved me-2 text-primary"></i>TrustIdentity <span class="text-primary-light">Licensing</span>
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="fas fa-list me-1"></i> Licenses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Keys"><i class="fas fa-key me-1"></i> Keys</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Validate"><i class="fas fa-check-circle me-1"></i> Verify</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            <p>&copy; 2026 TrustIdentity Licensing System. Built with Security First.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
