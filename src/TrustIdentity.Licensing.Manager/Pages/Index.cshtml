@page
@model IndexModel
@{
    ViewData["Title"] = "License Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 font-weight-bold">Issued Licenses</h1>
    <div>
        <a asp-page="Keys" class="btn btn-outline-light me-2"><i class="fas fa-key me-1"></i> Keys</a>
        <a asp-page="Create" class="btn btn-primary"><i class="fas fa-plus-circle me-1"></i> New License</a>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Customer</th>
                    <th>Type</th>
                    <th>Issued</th>
                    <th>Expires</th>
                    <th>Features</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var license in Model.Licenses)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@license.CustomerName</div>
                            <div class="small text-muted">@license.CustomerEmail</div>
                        </td>
                        <td>
                            <span class="badge @(license.LicenseType == "Enterprise" ? "bg-warning text-dark" : "bg-info text-dark")">
                                @license.LicenseType
                            </span>
                        </td>
                        <td>@license.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if(license.ExpiresAt < DateTime.UtcNow)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else
                            {
                                <span>@license.ExpiresAt.ToString("MMM dd, yyyy")</span>
                            }
                        </td>
                        <td>
                            @foreach(var feat in license.Features)
                            {
                                <span class="badge border border-secondary text-secondary small">@feat</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-primary" onclick="copyKey('@license.LicenseKey')">
                                <i class="fas fa-copy me-1"></i> Key
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Licenses.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-box-open fs-1 d-block mb-3"></i>
                            No licenses managed yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="copyToast" class="toast align-items-center text-white bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i> License key copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyKey(key) {
            navigator.clipboard.writeText(key).then(() => {
                const toast = new bootstrap.Toast(document.getElementById('copyToast'));
                toast.show();
            });
        }
    </script>
}
