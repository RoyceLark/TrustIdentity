@page
@model TrustIdentity.UI.Pages.Ciba.IndexModel
@{
    ViewData["Title"] = "Login Request";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-shield-alt"></i>
        </div>
        <h1>Login Request</h1>
        <p>Approval required</p>
    </div>

    <div class="auth-body">
        <div class="alert alert-info border-0" style="background: #f0f9ff; color: #0369a1; padding: 20px; border-radius: 12px; margin-bottom: 24px;">
            <div style="font-size: 14px; margin-bottom: 8px;"><b>@Model.ClientName</b> is requesting access to your account.</div>
            
            @if (!string.IsNullOrEmpty(Model.BindingMessage))
            {
                <div style="margin-top: 16px; padding: 12px; background: white; border-radius: 8px; border: 1px dashed #bae6fd; text-align: center;">
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #64748b; margin-bottom: 4px;">Binding Message</div>
                    <div style="font-size: 20px; font-weight: 800; font-family: monospace;">@Model.BindingMessage</div>
                </div>
            }
        </div>

        <p style="text-align: center; color: #64748b; font-size: 14px; margin-bottom: 32px;">
            By approving, you allow this application to access your identity information.
        </p>

        <form method="post">
            <input type="hidden" name="id" value="@Model.RequestId" />
            <div style="display: grid; gap: 12px;">
                <button type="submit" name="button" value="yes" class="btn btn-primary">
                    <i class="fas fa-check"></i> Approve Request
                </button>
                <button type="submit" name="button" value="deny" class="btn btn-secondary">
                    Deny
                </button>
            </div>
        </form>
    </div>
</div>
