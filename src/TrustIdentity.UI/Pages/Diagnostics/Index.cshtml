@page
@model TrustIdentity.UI.Pages.Diagnostics.IndexModel
@{
    ViewData["Title"] = "Diagnostics";
}

<div class="auth-card" style="max-width: 900px;">
    <div class="auth-header" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="auth-logo" style="background: rgba(255, 255, 255, 0.1);">
            <i class="fas fa-microchip"></i>
        </div>
        <h1>Identity Diagnostics</h1>
        <p>Technical overview of your current session claims</p>
    </div>

    <div class="auth-body">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
            <div>
                <h3 style="font-size: 16px; margin-bottom: 16px; color: #0f172a; font-weight: 700;">Active Claims</h3>
                <div style="background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <thead style="background: #f1f5f9;">
                            <tr>
                                <th style="text-align: left; padding: 12px 16px; border-bottom: 1px solid #e2e8f0;">Claim Type</th>
                                <th style="text-align: left; padding: 12px 16px; border-bottom: 1px solid #e2e8f0;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model.Claims)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px 16px;"><code style="color: #6366f1;">@claim.Type</code></td>
                                    <td style="padding: 12px 16px; color: #334155;">@claim.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.IdentityToken))
                {
                    <h3 style="font-size: 16px; margin: 24px 0 16px 0; color: #0f172a; font-weight: 700;">Raw ID Token</h3>
                    <div style="background: #0f172a; color: #38bdf8; padding: 16px; border-radius: 12px; font-family: monospace; font-size: 12px; word-break: break-all; line-height: 1.6;">
                        @Model.IdentityToken
                    </div>
                }
            </div>

            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div style="background: #6366f1; color: white; padding: 20px; border-radius: 16px; box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);">
                    <h4 style="font-size: 14px; font-weight: 700; margin-bottom: 12px;"><i class="fas fa-shield-alt"></i> Security Context</h4>
                    <div style="font-size: 13px; opacity: 0.9; margin-bottom: 16px;">
                        Detailed authentication context for debugging and verification.
                    </div>
                    <div style="display: grid; gap: 8px; font-size: 13px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span>Auth Type</span>
                            <span style="font-weight: 700;">@User.Identity?.AuthenticationType</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span>Authenticated</span>
                            <span style="font-weight: 700;">@(User.Identity?.IsAuthenticated ?? false ? "Yes" : "No")</span>
                        </div>
                    </div>
                </div>

                <div style="padding: 16px; background: #fff7ed; border: 1px solid #ffedd5; border-radius: 12px; color: #9a3412; font-size: 12px;">
                    <i class="fas fa-exclamation-triangle"></i> <b>WARNING:</b> This page contains sensitive data. Ensure you do not share screenshots of this page with unauthorized parties.
                </div>
            </div>
        </div>
        
        <div class="mt-4">
            <a href="/" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Home</a>
        </div>
    </div>
</div>
