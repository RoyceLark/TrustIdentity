@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "External Logins";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-link"></i>
        </div>
        <h1>External Logins</h1>
        <p>Manage your connected accounts</p>
    </div>

    <div class="auth-body">
        @if (Model.CurrentLogins.Any())
        {
            <h3 style="font-size: 16px; margin-bottom: 16px; color: #0f172a;">Connected Accounts</h3>
            <div style="display: grid; gap: 12px; margin-bottom: 24px;">
                @foreach (var login in Model.CurrentLogins)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; border: 2px solid #e2e8f0; border-radius: 12px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <i class="fab fa-@login.Name.ToLower()" style="font-size: 24px;"></i>
                            <span style="font-weight: 600;">@login.DisplayName</span>
                        </div>
                        <form method="post" asp-page-handler="RemoveLogin">
                            <input type="hidden" name="provider" value="@login.Name" />
                            <button type="submit" class="btn btn-secondary" style="width: auto;">Remove</button>
                        </form>
                    </div>
                }
            </div>
        }

        <h3 style="font-size: 16px; margin-bottom: 16px; color: #0f172a;">Add Account</h3>
        <div style="display: grid; gap: 12px;">
            @foreach (var login in Model.OtherLogins)
            {
                <form method="post" asp-page-handler="LinkLogin">
                    <input type="hidden" name="provider" value="@login.Name" />
                    <button type="submit" class="provider-btn" style="width: 100%;">
                        <i class="fab fa-@login.Name.ToLower()"></i>
                        Connect @login.DisplayName
                    </button>
                </form>
            }
        </div>

        <div class="mt-4">
            <a href="/Manage/Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Account
            </a>
        </div>
    </div>
</div>
