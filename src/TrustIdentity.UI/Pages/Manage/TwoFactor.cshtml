@page
@model TwoFactorModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="auth-card">
    <div class="auth-header">
        <h1>Two-Factor Authentication</h1>
        <p>Enhance your account security</p>
    </div>
    <div class="auth-body">
        @if (Model.IsTwoFactorEnabled)
        {
            <div style="background: #10b98120; color: #10b981; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center; border: 1px solid #10b981;">
                <i class="fas fa-check-circle"></i> Two-factor authentication is enabled.
            </div>
            <form method="post" asp-page-handler="Disable">
                <button type="submit" class="btn btn-danger">Disable 2FA</button>
            </form>
        }
        else
        {
            <div style="background: #f59e0b20; color: #f59e0b; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center; border: 1px solid #f59e0b;">
                <i class="fas fa-exclamation-triangle"></i> Two-factor authentication is not enabled yet.
            </div>
            <p>Two-factor authentication adds an extra layer of security to your account by requiring more than just a password to log in.</p>
            <form method="post" asp-page-handler="Enable">
                <button type="submit" class="btn btn-primary">Enable 2FA</button>
            </form>
        }
        <div style="margin-top: 24px;">
            <a href="/Manage/Index" class="btn btn-secondary">Back to Settings</a>
        </div>
    </div>
</div>
