@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-id-card"></i>
        </div>
        <h1>Edit Profile</h1>
        <p>Update your personal information</p>
    </div>

    <div class="auth-body">
        <form method="post">
            <div class="form-group">
                <label class="form-label" asp-for="Input.DisplayName"></label>
                <div class="input-icon">
                    <i class="fas fa-tag"></i>
                    <input asp-for="Input.DisplayName" class="form-control" placeholder="Your full name" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.PhoneNumber"></label>
                <div class="input-icon">
                    <i class="fas fa-phone"></i>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                </div>
            </div>

            <div class="mt-4" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Manage/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
