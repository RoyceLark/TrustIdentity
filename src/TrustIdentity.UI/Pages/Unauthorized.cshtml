@page
@model TrustIdentity.UI.Pages.UnauthorizedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-card">
    <div class="auth-header" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
        <div class="auth-logo" style="background: rgba(255, 255, 255, 0.2);">
            <i class="fas fa-hand-slash"></i>
        </div>
        <h1>Access Denied</h1>
        <p>Restricted area</p>
    </div>

    <div class="auth-body text-center">
        <div class="mb-5">
            <div style="font-size: 72px; font-weight: 800; color: #ef4444; line-height: 1;">403</div>
            <p style="color: #64748b; margin-top: 16px; font-size: 16px;">
                You do not have permission to access this resource. If you believe this is an error, please contact your administrator.
            </p>
        </div>
        
        <div style="display: grid; gap: 12px;">
            <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Go Home</a>
            <a href="/Account/Login" class="btn btn-secondary"><i class="fas fa-user"></i> Switch Account</a>
        </div>
    </div>
</div>
