@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            @if (ViewData["LogoUri"] != null)
            {
                <img src="@ViewData["LogoUri"]" alt="Logo" style="max-width: 100%; max-height: 100%; border-radius: 12px;" />
            }
            else
            {
                <i class="fas fa-shield-halved"></i>
            }
        </div>
        <h1>Welcome Back</h1>
        <p>Sign in to continue to your account</p>
    </div>

    <div class="auth-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (Model.ShowExternalProviders)
        {
            <div class="external-providers">
                @foreach (var provider in Model.ExternalProviders)
                {
                    <form method="post" asp-page-handler="External" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                        <input type="hidden" name="provider" value="@provider.Name" />
                        <button type="submit" class="provider-btn mb-2" title="Sign in with @provider.DisplayName">
                            @if (provider.Name.Contains("Google", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="fab fa-google" style="color: #DB4437;"></i>
                            }
                            else if (provider.Name.Contains("Microsoft", StringComparison.OrdinalIgnoreCase) || provider.Name.Contains("Azure", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="fab fa-microsoft" style="color: #00A4EF;"></i>
                            }
                            else if (provider.Name.Contains("GitHub", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="fab fa-github" style="color: #333;"></i>
                            }
                            else if (provider.Name.Contains("Facebook", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="fab fa-facebook" style="color: #1877F2;"></i>
                            }
                            else
                            {
                                <i class="fas fa-sign-in-alt"></i>
                            }
                            @provider.DisplayName
                        </button>
                    </form>
                }
            </div>

            <div class="divider">
                <span>or continue with email</span>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="form-group">
                <label class="form-label" asp-for="Input.Username">Email or Username</label>
                <div class="input-icon">
                    <i class="fas fa-user"></i>
                    <input asp-for="Input.Username" 
                           class="form-control" 
                           placeholder="Enter your email or username"
                           autocomplete="username"
                           required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Password">Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Input.Password" 
                           type="password"
                           class="form-control" 
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required />
                </div>
            </div>

            <div class="remember-forgot">
                <label class="checkbox-label">
                    <input asp-for="Input.RememberMe" type="checkbox" />
                    <span>Remember me</span>
                </label>
                <a href="/Account/ForgotPassword" class="link">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary">
                <div class="loading"></div>
                <span><i class="fas fa-sign-in-alt"></i> Sign In</span>
            </button>

            <div class="security-badge">
                <i class="fas fa-shield-check"></i>
                <span>Protected by AI-powered fraud detection</span>
            </div>
        </form>
    </div>

    <div class="auth-footer">
        Don't have an account? <a href="/Account/Register" class="link">Sign up</a>
    </div>
</div>
