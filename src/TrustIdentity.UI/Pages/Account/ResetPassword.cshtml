@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-lock-open"></i>
        </div>
        <h1>Reset Password</h1>
        <p>Enter your new password</p>
    </div>

    <div class="auth-body">
        <form method="post">
            <input type="hidden" asp-for="Input.Code" />
            
            <div class="form-group">
                <label class="form-label" asp-for="Input.Email">Email</label>
                <div class="input-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" required />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Password">New Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" required />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.ConfirmPassword">Confirm Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <div class="loading"></div>
                <span><i class="fas fa-check"></i> Reset Password</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
