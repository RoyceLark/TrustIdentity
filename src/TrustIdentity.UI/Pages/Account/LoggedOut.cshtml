@page
@model LoggedOutModel
@{
    ViewData["Title"] = "Logged Out";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1>Logged Out</h1>
        <p>You have successfully logged out.</p>
    </div>

    <div class="auth-body text-center">
        @if (Model.PostLogoutRedirectUri != null)
        {
            <p>Click <a href="@Model.PostLogoutRedirectUri" class="link">here</a> to return to the <b>@Model.ClientName</b> application.</p>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <span>You are now safely signed out of TrustIdentity.</span>
            </div>
            <a href="/Account/Login" class="btn btn-primary mt-3">Sign in again</a>
        }
    </div>
</div>
