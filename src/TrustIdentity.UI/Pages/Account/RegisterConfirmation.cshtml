@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-envelope-circle-check"></i>
        </div>
        <h1>Confirm Registration</h1>
        <p>We've sent a verification link to your email</p>
    </div>

    <div class="auth-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <span>Please check your inbox (<b>@Model.Email</b>) and click the link to verify your account.</span>
        </div>

        <p class="text-center mt-4">
            Didn't receive the email? <a href="#" class="link">Resend verification</a>
        </p>

        <div class="mt-4">
            <a href="/Account/Login" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>
</div>
