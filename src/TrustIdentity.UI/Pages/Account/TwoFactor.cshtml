@page
@model TwoFactorModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-mobile-alt"></i>
        </div>
        <h1>Two-Factor Authentication</h1>
        <p>Enter the code from your authenticator app</p>
    </div>

    <div class="auth-body">
        <form method="post">
            <input type="hidden" name="RememberMe" value="@Model.RememberMe" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            
            <div class="form-group">
                <label class="form-label" asp-for="Input.TwoFactorCode">Verification Code</label>
                <div class="input-icon">
                    <i class="fas fa-key"></i>
                    <input asp-for="Input.TwoFactorCode" 
                           class="form-control" 
                           placeholder="000000"
                           autocomplete="off"
                           style="text-align: center; font-size: 24px; letter-spacing: 8px; font-weight: 600;"
                           maxlength="6"
                           required />
                </div>
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="Input.RememberMachine" type="checkbox" />
                    <span>Remember this device</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary">
                <div class="loading"></div>
                <span><i class="fas fa-sign-in-alt"></i> Verify & Sign In</span>
            </button>

            <div style="text-align: center; margin-top: 16px;">
                <a href="/Account/RecoveryCode" class="link">Use a recovery code</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-submit when 6 digits entered
        const input = document.querySelector('input[name="Input.TwoFactorCode"]');
        input?.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length === 6) {
                this.form.submit();
            }
        });
    </script>
}
