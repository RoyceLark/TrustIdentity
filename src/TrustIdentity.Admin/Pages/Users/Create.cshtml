@page
@model TrustIdentity.Admin.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Users</a></li>
            <li class="breadcrumb-item active">New User</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h1 class="h3 mb-0">Create User</h1>
                    <p class="text-muted small mb-0">Add a new user to the identity system</p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Username" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.Username" class="form-control" placeholder="Choose a username" />
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Input.IsActive">
                                <label class="form-check-label fw-bold" asp-for="Input.IsActive"></label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="./Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">Create User</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
