@page "{id}"
@model TrustIdentity.Admin.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "User Details - " + Model.User.Username;
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Users</a></li>
            <li class="breadcrumb-item active">@Model.User.Username</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="avatar-large me-3">
                @Model.User.Username.Substring(0, 1).ToUpper()
            </div>
            <div>
                <h1 class="h3 mb-0 text-gray-800">@Model.User.Username</h1>
                <p class="text-muted small mb-0">Subject ID: @Model.User.SubjectId</p>
            </div>
        </div>
        <div class="btn-group">
            <a asp-page="./Edit" asp-route-id="@Model.User.SubjectId" class="btn btn-primary px-4">Edit Profile</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Email</div>
                        <div class="col-sm-8 text-dark">@Model.User.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Status</div>
                        <div class="col-sm-8">
                            @if (Model.User.IsActive)
                            {
                                <span class="badge bg-success-soft text-success px-3">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-soft text-danger px-3">Locked / Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Joined</div>
                        <div class="col-sm-8 text-dark">@Model.User.CreatedDate.ToString("MMMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Last Login</div>
                        <div class="col-sm-8 text-dark">@(Model.User.LastLoginDate?.ToString("MMMM dd, yyyy HH:mm") ?? "Never")</div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">User Claims</h5>
                        <button class="btn btn-sm btn-outline-primary">+ Add Claim</button>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-sm border-0">
                            <thead class="bg-light small">
                                <tr>
                                    <th class="border-0">Type</th>
                                    <th class="border-0">Value</th>
                                    <th class="border-0"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.User.Claims)
                                {
                                    <tr>
                                        <td class="small fw-bold border-top-0">@claim.Type</td>
                                        <td class="small border-top-0">@claim.Value</td>
                                        <td class="text-end border-top-0">
                                            <button class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.User.Claims.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-3 text-muted small">No custom claims found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4 bg-dark text-white">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="mb-0">AI Security Profile</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="mb-4">
                        <label class="small text-uppercase opacity-50 d-block mb-2">Current Risk Level</label>
                        <div class="d-flex align-items-center">
                            <h2 class="mb-0 me-3">Low</h2>
                            <span class="badge bg-success">0.12</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-uppercase opacity-50 d-block">Trust Score</label>
                        <div class="progress mt-1" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 85%;"></div>
                        </div>
                    </div>

                    <div class="small mt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="opacity-75">Behavioral Match</span>
                            <span class="text-success">98%</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="opacity-75">Known Devices</span>
                            <span>2</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="opacity-75">Recent Anomalies</span>
                            <span class="text-success">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">Security Actions</h5>
                </div>
                <div class="card-body pt-0">
                    <button class="btn btn-outline-warning w-100 mb-2">Reset Password</button>
                    @if (Model.User.IsActive)
                    {
                        <button class="btn btn-outline-danger w-100 mb-2">Lock Account</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-success w-100 mb-2">Unlock Account</button>
                    }
                    <button class="btn btn-outline-secondary w-100">Force Logout</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-large {
        width: 60px;
        height: 60px;
        background-color: #4e73df;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.5rem;
    }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
</style>
