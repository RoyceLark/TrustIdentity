@page
@model TrustIdentity.Admin.Pages.Resources.IndexModel
@{
    ViewData["Title"] = "Resources";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Resources</h1>
            <p class="text-muted">Manage Identity Resources, API Resources and Scopes</p>
        </div>
    </div>

    <!-- Tabs Nav -->
    <ul class="nav nav-tabs border-bottom-0 mb-4" id="resourceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4" id="identity-tab" data-bs-toggle="tab" data-bs-target="#identity" type="button" role="tab">Identity Resources</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4" id="api-resources-tab" data-bs-toggle="tab" data-bs-target="#api-resources" type="button" role="tab">API Resources</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4" id="api-scopes-tab" data-bs-toggle="tab" data-bs-target="#api-scopes" type="button" role="tab">API Scopes</button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Resources</h1>
            <p class="text-muted">Manage identity resources, API resources, and scopes.</p>
        </div>
        <div class="col-md-6 text-end">
            <div class="btn-group">
                <a asp-page="CreateIdentity" class="btn btn-outline-primary">
                    <i class="fas fa-plus me-1"></i> Identity
                </a>
                <a asp-page="CreateApiResource" class="btn btn-outline-primary">
                    <i class="fas fa-plus me-1"></i> API
                </a>
                <a asp-page="CreateApiScope" class="btn btn-outline-primary">
                    <i class="fas fa-plus me-1"></i> Scope
                </a>
            </div>
            
            <div class="btn-group ms-2">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-cog me-1"></i> Config
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <form method="post" asp-page-handler="Export" class="d-inline">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-download me-2"></i> Export JSON
                            </button>
                        </form>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#importModal">
                            <i class="fas fa-upload me-2"></i> Import JSON
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="tab-content" id="resourceTabsContent">
        <!-- Identity Resources -->
        <div class="tab-pane fade show active" id="identity" role="tabpanel">
            <div class="d-flex justify-content-end mb-3">
                <a asp-page="./CreateIdentity" class="btn btn-sm btn-primary">Add Identity Resource</a>
            </div>
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 border-0 text-uppercase small fw-bold text-muted">Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Display Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Required</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted text-end px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.IdentityResources)
                            {
                                <tr>
                                    <td class="px-4 py-3 border-top fw-bold text-primary">@res.Name</td>
                                    <td class="py-3 border-top">@res.DisplayName</td>
                                    <td class="py-3 border-top">@(res.Required ? "Yes" : "No")</td>
                                    <td class="py-3 border-top text-end px-4">
                                        <div class="btn-group">
                                            <a asp-page="./EditIdentity" asp-route-id="@res.Name" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form method="post" asp-page-handler="DeleteIdentity" asp-route-name="@res.Name" class="d-inline" onsubmit="return confirm('Delete this identity resource?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- API Resources -->
        <div class="tab-pane fade" id="api-resources" role="tabpanel">
            <div class="d-flex justify-content-end mb-3">
                <a asp-page="./CreateApiResource" class="btn btn-sm btn-primary">Add API Resource</a>
            </div>
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 border-0 text-uppercase small fw-bold text-muted">Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Display Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Scopes</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted text-end px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.ApiResources)
                            {
                                <tr>
                                    <td class="px-4 py-3 border-top fw-bold text-primary">@res.Name</td>
                                    <td class="py-3 border-top">@res.DisplayName</td>
                                    <td class="py-3 border-top">
                                        @foreach (var scope in res.Scopes)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@scope</span>
                                        }
                                    </td>
                                    <td class="py-3 border-top text-end px-4">
                                        <div class="btn-group">
                                            <a asp-page="./EditApiResource" asp-route-id="@res.Name" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form method="post" asp-page-handler="DeleteApiResource" asp-route-name="@res.Name" class="d-inline" onsubmit="return confirm('Delete this API resource?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- API Scopes -->
        <div class="tab-pane fade" id="api-scopes" role="tabpanel">
            <div class="d-flex justify-content-end mb-3">
                <a asp-page="./CreateApiScope" class="btn btn-sm btn-primary">Add API Scope</a>
            </div>
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 border-0 text-uppercase small fw-bold text-muted">Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Display Name</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Required</th>
                                <th class="py-3 border-0 text-uppercase small fw-bold text-muted text-end px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var scope in Model.ApiScopes)
                            {
                                <tr>
                                    <td class="px-4 py-3 border-top fw-bold text-primary">@scope.Name</td>
                                    <td class="py-3 border-top">@scope.DisplayName</td>
                                    <td class="py-3 border-top">@(scope.Required ? "Yes" : "No")</td>
                                    <td class="py-3 border-top text-end px-4">
                                        <div class="btn-group">
                                            <a asp-page="./EditApiScope" asp-route-id="@scope.Name" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form method="post" asp-page-handler="DeleteApiScope" asp-route-name="@scope.Name" class="d-inline" onsubmit="return confirm('Delete this API scope?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link { 
        color: #6c757d; 
        border: none; 
        border-bottom: 3px solid transparent;
        padding-bottom: 1rem;
    }
    .nav-tabs .nav-link.active { 
        color: #4e73df; 
        background: none; 
        border-bottom: 3px solid #4e73df;
    }
</style>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Import Configuration</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="importFile" class="form-label">Configuration File (JSON)</label>
                        <input type="file" class="form-control" id="importFile" name="ImportFile" accept=".json" required>
                    </div>
                    <div class="alert alert-warning small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Existing resources with matching IDs will be updated. New resources will be added.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </div>
        </form>
    </div>
</div>
