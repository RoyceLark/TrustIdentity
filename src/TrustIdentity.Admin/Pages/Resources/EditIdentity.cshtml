@page "{id}"
@model TrustIdentity.Admin.Pages.Resources.EditIdentityModel
@{
    ViewData["Title"] = "Edit Identity Resource - " + Model.Input.Name;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Resources</a></li>
            <li class="breadcrumb-item active">Edit Identity Resource</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h1 class="h3 mb-0">Edit Identity Resource</h1>
                    <p class="text-muted small mb-0">Identity resource: <strong>@Model.Input.Name</strong></p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Input.Name" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.DisplayName" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.DisplayName" class="form-control" />
                            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Description" class="form-label fw-bold small text-uppercase"></label>
                            <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <div class="mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="Input.Required">
                                <label class="form-check-label fw-bold" asp-for="Input.Required">Required</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="Input.Emphasize">
                                <label class="form-check-label fw-bold" asp-for="Input.Emphasize">Emphasize</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="Input.ShowInDiscoveryDocument">
                                <label class="form-check-label fw-bold" asp-for="Input.ShowInDiscoveryDocument">Discovery</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="./Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
