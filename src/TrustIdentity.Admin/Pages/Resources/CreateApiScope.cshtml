@page
@model TrustIdentity.Admin.Pages.Resources.CreateApiScopeModel
@{
    ViewData["Title"] = "Create API Scope";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Resources</a></li>
            <li class="breadcrumb-item active">New API Scope</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h1 class="h3 mb-0">Create API Scope</h1>
                    <p class="text-muted small mb-0">Scopes define specific access levels for an API</p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. products.read, orders.write" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.DisplayName" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.DisplayName" class="form-control" placeholder="e.g. Read Access to Products" />
                            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Description" class="form-label fw-bold small text-uppercase"></label>
                            <textarea asp-for="Input.Description" class="form-control" rows="2" placeholder="Explain what this scope allows..."></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.UserClaims" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Input.UserClaims" class="form-control" placeholder="role, department, location (comma separated)" />
                            <div class="form-text small">Claims that should be included in the access token when this scope is requested.</div>
                        </div>

                        <hr class="my-4">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.Required">
                                    <label class="form-check-label fw-bold" asp-for="Input.Required"></label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.Emphasize">
                                    <label class="form-check-label fw-bold" asp-for="Input.Emphasize"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="./Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">Create Scope</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
