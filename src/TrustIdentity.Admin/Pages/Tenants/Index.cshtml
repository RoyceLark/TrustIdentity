@page
@model TrustIdentity.Admin.Pages.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Tenants</h1>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create Tenant
        </a>
    </div>

    @if (ViewContext.HttpContext.Request.Cookies.ContainsKey("Ti-Tenant-Id"))
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-mask me-2"></i> 
                <strong>Super Admin Mode:</strong> You are currently impersonating tenant <code>@ViewContext.HttpContext.Request.Cookies["Ti-Tenant-Id"]</code>
            </div>
            <form method="post" asp-page-handler="ResetSwitch" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-dark">
                    <i class="fas fa-times"></i> Stop Impersonating
                </button>
            </form>
        </div>
    }

    @if (!Model.Tenants.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No tenants found. Create your first tenant to get started.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Identifier</th>
                                <th>Host</th>
                                <th>Status</th>
                                <th>Subscription</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tenant in Model.Tenants)
                            {
                                <tr>
                                    <td>
                                        <strong>@tenant.Name</strong>
                                    </td>
                                    <td>
                                        <code>@tenant.Identifier</code>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tenant.Host))
                                        {
                                            <span class="badge bg-info">@tenant.Host</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (tenant.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tenant.SubscriptionTier))
                                        {
                                            <span class="badge bg-primary">@tenant.SubscriptionTier</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@tenant.CreatedAt.ToString("yyyy-MM-dd")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-page="Edit" asp-route-id="@tenant.Id" class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-page="Details" asp-route-id="@tenant.Id" class="btn btn-outline-info" title="Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Switch" asp-route-id="@tenant.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-warning" title="Switch Context">
                                                    <i class="fas fa-random"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@tenant.Id" class="d-inline" 
                                                  onsubmit="return confirm('Are you sure you want to delete this tenant? This action cannot be undone.');">
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalCount > Model.PageSize)
                {
                    <nav aria-label="Tenant pagination">
                        <ul class="pagination justify-content-center mt-3">
                            @for (int i = 1; i <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                <i class="fas fa-info-circle"></i> 
                Showing @Model.Tenants.Count() of @Model.TotalCount tenants
            </p>
        </div>
    }
</div>
