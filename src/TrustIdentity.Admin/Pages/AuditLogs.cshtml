@page
@model TrustIdentity.Admin.Pages.AuditLogsModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Audit Logs</h1>
            <p class="text-muted">Real-time system events and security monitoring</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise me-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
            </svg>
            Refresh
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3 border-0 text-uppercase small fw-bold text-muted">Timestamp</th>
                        <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Event Type</th>
                        <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Subject / Client</th>
                        <th class="py-3 border-0 text-uppercase small fw-bold text-muted">Message</th>
                        <th class="py-3 border-0 text-uppercase small fw-bold text-muted">IP Address</th>
                        <th class="py-3 border-0 text-uppercase small fw-bold text-muted text-end px-4">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Events.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center text-muted">
                                <p class="mb-0">No audit events found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var evt in Model.Events)
                    {
                        <tr>
                            <td class="px-4 py-3 border-top small text-muted">
                                @evt.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td class="py-3 border-top">
                                <span class="badge @GetBadgeClass(evt.EventType)">@evt.EventType</span>
                            </td>
                            <td class="py-3 border-top small">
                                <div><span class="text-muted">Sub:</span> @(evt.SubjectId ?? "-")</div>
                                <div><span class="text-muted">Cli:</span> @(evt.ClientId ?? "-")</div>
                            </td>
                            <td class="py-3 border-top small text-dark">
                                @evt.Message
                            </td>
                            <td class="py-3 border-top small">
                                @evt.IpAddress
                            </td>
                            <td class="py-3 border-top text-end px-4">
                                <button type="button" class="btn btn-sm btn-link text-primary" 
                                        data-bs-toggle="modal" data-bs-target="#eventModal" 
                                        data-event='@Json.Serialize(evt)'>View Data</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Event Details Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Event Payload</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <pre id="eventDataJson" class="bg-dark text-success p-3 mb-0" style="max-height: 500px; overflow: auto;"></pre>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string type)
    {
        return type switch
        {
            "TokenIssued" => "bg-success-soft text-success",
            "UserLogin" => "bg-primary-soft text-primary",
            "UserLoginFailed" => "bg-danger-soft text-danger",
            "TokenIssueFailed" => "bg-warning-soft text-warning",
            _ => "bg-light text-dark"
        };
    }
}

<style>
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
</style>

@section Scripts {
    <script>
        const eventModal = document.getElementById('eventModal');
        if (eventModal) {
            eventModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const evtData = JSON.parse(button.getAttribute('data-event'));
                const jsonPre = eventModal.querySelector('#eventDataJson');
                jsonPre.textContent = JSON.stringify(evtData, null, 2);
            });
        }
    </script>
}
